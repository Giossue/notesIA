# Copiar a .env y reemplazar la contraseña por la del rol local de la aplicación.
DATABASE_URL=postgresql://notesia_app:REPLACE_ME@127.0.0.1:5432/notesia_dev
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
ALLOW_SIGNUP=false
NODE_ENV=development

# Recuperación de contraseña (configurar en API y worker con los mismos valores).
# PASSWORD_RESET_URL=https://app.example.invalid/reset-password
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=access@example.invalid
# SMTP_USER=REPLACE_ME
# SMTP_PASSWORD=REPLACE_ME

# IA (32 bytes aleatorios codificados en base64; necesario para guardar conexiones).
# AI_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Respaldo cifrado local; guardar la clave fuera de este repositorio.
# BACKUP_ENCRYPTION_KEY=REPLACE_WITH_ANOTHER_BASE64_32_BYTE_KEY

# Eliminación de cuenta: habilitar solo tras aprobar plazos; mismos valores en API y worker.
# ACCOUNT_DELETION_GRACE_DAYS=APPROVED_DAYS_1_TO_90
# ACCOUNT_DELETION_AUDIT_RETENTION_DAYS=APPROVED_DAYS_1_TO_3650
# ACCOUNT_DELETION_AUDIT_KEY=REPLACE_WITH_ANOTHER_BASE64_32_BYTE_KEY

# Push FCM: la clave de cifrado va en API y worker; las credenciales Google solo en worker.
# PUSH_ENCRYPTION_KEY=REPLACE_WITH_ANOTHER_BASE64_32_BYTE_KEY
# FCM_PROJECT_ID=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json

# Alertas operativas firmadas (solo API; el receptor debe deduplicar por Idempotency-Key).
# OPS_ALERT_WEBHOOK_URL=https://alerts.example.invalid/notesia
# OPS_ALERT_WEBHOOK_SECRET=REPLACE_WITH_ANOTHER_BASE64_32_BYTE_KEY
# OPS_ALERT_SOURCE=notesia-production
# OPS_ALERT_CHECK_INTERVAL_SECONDS=30
# OPS_ALERT_REPEAT_INTERVAL_SECONDS=900
