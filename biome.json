{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/.expo",
      "!!**/android",
      "!!**/ios",
      "!!**/playwright-report",
      "!!**/test-results"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["apps/mobile/**", "!apps/mobile/src/shared/paper.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react-native-paper": {
                    "importNames": [
                      "Button",
                      "Card",
                      "Dialog",
                      "Menu",
                      "SegmentedButtons",
                      "TextInput"
                    ],
                    "message": "Usa Button, Card, Dialog, Menu y TextInput de @/shared/paper, y Tabs de @/shared/Tabs en lugar de SegmentedButtons, para mantener el estilo global."
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
